    "idmapper": [
        "vtable = { [-2] = 13, [1] = 14, [2] = 15, [-4] = 8, [3] = 17, [4] = 18, [-6] = 23, [5] = 24, [6] = 25 }",
        "function getVolumeID(system, layer)",
        "    if system == 3 and layer == 2 then return 20 end",
        "    if system == 4 and layer ~= 0 then return 21 end",
        "    if system == -4 and layer ~= 0 then return 3 end",
        "    return vtable[system]",
        "end",
        "function getLayerID(system, layer)",
        "    if system == -2 then return 2 * (7 - layer) + 2 end",
        "    if system == 1 or system == 2 then return 2 * (layer + 1) end",
        "    if system == 2 then return 2 * layer + 2 end",
        "    if system == 3 and layer == 2 then return 2 * (2 - layer) + 2 end",
        "    if system == 3 or system == 5 then return 2 * layer + 2 end",
        "    if system == -4 and layer ~= 0 then return 2 * (7 - layer) end",
        "    if system == 4 and layer ~= 0 then return 2 * layer end",
        "    if system == -4 then return 2 - 2 * layer end",
        "    if system == 4 then return 2 * layer + 2 end",
        "    if system == -6 then return 2 * (3 - layer) + 2 end",
        "    if system == 6 then return 2 * layer + 2 end",
        "    return layer",
        "end",
        "function getLadderNumber(system, layer)",
        "    if system == 1 then return 5 end",
        "    if system == 3 and layer == 2 then return 46 end",
        "    if system == 3 then return 32 end",
        "    if system == 5 then return 84 end",
        "    if system == 2 then return 0 end",
        "    if system == 4 and layer ~= 0 then return 26 end",
        "    if system == -4 and layer ~= 0 then return 26 end",
        "    if system == -4 or system == 4 then return 26 end",
        "    if system == -6 or system == 6 then return 48 end",
        "    return nil",
        "end",
        "function getSensorID(system, layer, ladder, sensor)",
        "    lnum = getLadderNumber(system, layer)",
        "    if lnum then return lnum * ladder + sensor + 1 end",
        "    if system == -2 then return 16 - sensor end",
        "    return ladder",
        "end"
    ]
